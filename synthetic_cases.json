{
  "rules": [
    {
      "id": "R1",
      "text": "An application filed by the deadline is eligible for review.",
      "when": {"filed_by_deadline": true},
      "outcome": "review_available"
    },
    {
      "id": "R2",
      "text": "A late application is ineligible if the applicant received the required notice.",
      "when": {"filed_by_deadline": false, "received_required_notice": true},
      "outcome": "review_unavailable"
    },
    {
      "id": "R3",
      "text": "A late application remains eligible if the agency failed to give the required notice.",
      "when": {"filed_by_deadline": false, "received_required_notice": false},
      "outcome": "review_available"
    }
  ],
